# Öffentliche Adresse der Seite (für Stripe-Weiterleitungen)
BASE_URL=http://localhost:3000
PORT=3000

# Stripe (https://dashboard.stripe.com/apikeys). Ohne Key läuft die App im
# Testmodus: "Pro holen" schaltet Pro sofort frei, ohne Zahlung.
STRIPE_SECRET_KEY=
# Preis-ID des Abos (Produkt anlegen -> wiederkehrender Preis), z. B. price_123
STRIPE_PRICE_ID=
# Webhook-Secret (Dashboard -> Entwickler -> Webhooks, oder `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Datenbankdatei
DB_PATH=data.db
