# Öffentliche Adresse der Seite (für Stripe-Weiterleitungen und sichere Cookies)
BASE_URL=http://localhost:3000
PORT=3000
APP_NAME=Rechnungsblitz

# Hinter einem Reverse-Proxy/Hoster (Render, Railway, Fly, nginx) auf 1 setzen
TRUST_PROXY=

# Datenbankdatei – bei Hostern auf ein dauerhaftes Volume legen, z. B. /data/data.db
DB_PATH=data.db

# Stripe (https://dashboard.stripe.com/apikeys). Ohne Key läuft die App im
# Testmodus: Upgrades auf Pro sind dann kostenlos.
STRIPE_SECRET_KEY=
# Preis-IDs der beiden wiederkehrenden Preise (Produkt "Pro"), z. B. price_123
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Webhook-Secret (Dashboard → Entwickler → Webhooks, oder `stripe listen`)
STRIPE_WEBHOOK_SECRET=
